+    mixer[ui::kColorSysHeaderContainer] = {selection};
+    mixer[ui::kColorSysHeaderContainerInactive] = {surface};
+    mixer[ui::kColorSysSurface] = {surface};
+    mixer[ui::kColorSysSurface1] = {raised};
+    mixer[ui::kColorSysSurface2] = {surface};
+    mixer[ui::kColorSysSurface3] = {raised};
+    mixer[ui::kColorSysSurface4] = {raised};
+    mixer[ui::kColorSysSurface5] = {raised};
+    mixer[ui::kColorSysSurfaceVariant] = {raised};
+    mixer[ui::kColorSysBase] = {raised};
