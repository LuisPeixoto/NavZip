+    const SkColor selection = dark ? SkColorSetRGB(0x24, 0x46, 0x38)
+                                   : SkColorSetRGB(0xd8, 0xef, 0xe2);
+    const SkColor outline = dark ? SkColorSetRGB(0x3b, 0x43, 0x48)
+                                 : SkColorSetRGB(0xc6, 0xd2, 0xcb);
+
+    // WebUI and native controls share the same semantic palette, including
+    // Settings, dialogs, links, selected navigation items and focus outlines.
+    mixer[ui::kColorSysPrimary] = {mint};
+    mixer[ui::kColorSysOnPrimary] = {on_mint};
