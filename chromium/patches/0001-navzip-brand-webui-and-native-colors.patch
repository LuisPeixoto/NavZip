+void AddNavZipColorMixer(ui::ColorProvider* provider,
+                         const ui::ColorProviderKey& key) {
+  // Apply after Material recipes; preserve custom themes and high contrast.
+  if (!key.custom_theme && !ShouldApplyHighContrastColors(key)) {
+    const bool dark = key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+    ui::ColorMixer& mixer = provider->AddMixer();
+    const SkColor surface = dark ? SkColorSetRGB(0x10, 0x15, 0x17)
+                                 : SkColorSetRGB(0xf4, 0xf7, 0xf5);
+    const SkColor raised =
+        dark ? SkColorSetRGB(0x20, 0x26, 0x29) : SK_ColorWHITE;
+    const SkColor text = dark ? SkColorSetRGB(0xf2, 0xf2, 0xee)
+                              : SkColorSetRGB(0x1c, 0x29, 0x24);
+    const SkColor muted = dark ? SkColorSetRGB(0xa7, 0xaf, 0xb5)
+                               : SkColorSetRGB(0x54, 0x66, 0x5d);
