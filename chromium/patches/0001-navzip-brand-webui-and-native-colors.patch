+TEST_F(NewTabPageHandlerTest, NavZipStartsWithNoBundledShortcuts) {
+  base::test::TestFuture<new_tab_page::mojom::NavZipPreferencesPtr> loaded;
+  handler_->GetNavZipPreferences(loaded.GetCallback());
+  EXPECT_TRUE(loaded.Take()->shortcuts.empty());
+}
+
+TEST_F(NewTabPageHandlerTest, NavZipRetiresBundledShortcutsButKeepsUserSites) {
+  base::ListValue shortcuts;
+  for (const char* id :
+       {"github", "youtube", "figma", "gmail", "chatgpt", "user-created-id"}) {
+    shortcuts.Append(base::DictValue()
+                         .Set("id", id)
+                         .Set("title", "Site")
+                         .Set("url", "https://example.org/"));
+  }
+  profile_->GetPrefs()->SetDict("navzip.new_tab",
+                                base::DictValue()
+                                    .Set("name", "Previous name")
+                                    .Set("city", "Previous city")
+                                    .Set("weather_enabled", true)
+                                    .Set("shortcuts", std::move(shortcuts)));
+  base::test::TestFuture<new_tab_page::mojom::NavZipPreferencesPtr> loaded;
+  handler_->GetNavZipPreferences(loaded.GetCallback());
+  const auto result = loaded.Take();
+  ASSERT_EQ(1u, result->shortcuts.size());
+  EXPECT_EQ("user-created-id", result->shortcuts[0]->id);
+}
+
+TEST_F(NewTabPageHandlerTest, NavZipPreferencesRoundTripAndAtomicRejection) {
+  auto valid = new_tab_page::mojom::NavZipPreferences::New();
+  valid->shortcuts.push_back(new_tab_page::mojom::NavZipShortcut::New(
+      "custom-github", "GitHub", "https://github.com/"));
+  base::test::TestFuture<bool> saved;
+  handler_->SetNavZipPreferences(valid.Clone(), saved.GetCallback());
+  ASSERT_TRUE(saved.Get());
+  const auto before = profile_->GetPrefs()->GetDict("navzip.new_tab").Clone();
+
+  for (const char* url : {"javascript:alert(1)", "file:///etc/passwd",
+                          "https://user:secret@example.org/"}) {
+    auto invalid = valid.Clone();
+    invalid->shortcuts[0]->url = url;
+    base::test::TestFuture<bool> rejected;
+    handler_->SetNavZipPreferences(std::move(invalid), rejected.GetCallback());
+    EXPECT_FALSE(rejected.Get());
+    EXPECT_EQ(before, profile_->GetPrefs()->GetDict("navzip.new_tab"));
+  }
+  base::test::TestFuture<new_tab_page::mojom::NavZipPreferencesPtr> loaded;
+  handler_->GetNavZipPreferences(loaded.GetCallback());
+  const auto result = loaded.Take();
+  ASSERT_EQ(1u, result->shortcuts.size());
+  EXPECT_EQ("https://github.com/", result->shortcuts[0]->url);
+}
+
+TEST_F(NewTabPageHandlerTest, NavZipRejectsAmbiguousShortcutIds) {
+  auto invalid = new_tab_page::mojom::NavZipPreferences::New();
+  invalid->shortcuts.push_back(new_tab_page::mojom::NavZipShortcut::New(
+      "same", "One", "https://example.org/"));
+  invalid->shortcuts.push_back(new_tab_page::mojom::NavZipShortcut::New(
+      "same", "Two", "https://example.com/"));
+  const auto before = profile_->GetPrefs()->GetDict("navzip.new_tab").Clone();
+  base::test::TestFuture<bool> rejected;
+  handler_->SetNavZipPreferences(std::move(invalid), rejected.GetCallback());
+  EXPECT_FALSE(rejected.Get());
+  EXPECT_EQ(before, profile_->GetPrefs()->GetDict("navzip.new_tab"));
+}
+
